{
  "mcpServers": {
    "zvec_grep": {
      "command": "zg",
      "args": ["server", "--stdio", "--mcp-toolset", "agent"],
      "tool_timeout_sec": 600,
      "default_tools_approval_mode": "approve"
    },
    "sentrux": {
      "command": "sentrux",
      "args": ["--mcp"],
      "tool_timeout_sec": 600,
      "default_tools_approval_mode": "approve"
    }
  }
}

